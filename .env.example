# ─── LLM ──────────────────────────────────────────────────────────────
# Primary provider. Falls through to the fallback provider on errors or
# when the primary's API key is missing.
#
# Valid providers: openai | deepseek | gemini | groq

LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-nano

LLM_FALLBACK_PROVIDER=deepseek
LLM_FALLBACK_MODEL=deepseek-chat

# Provider API keys. Only the providers you actually use need a key.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ─── Pre-configured models (for reference; override via LLM_MODEL above) ──
# openai      gpt-5.4-nano · gpt-5.4-mini · gpt-5.4 · gpt-4o-mini · gpt-4o · gpt-4-turbo · o1-mini · o1
# deepseek    deepseek-chat (V3) · deepseek-reasoner (R1)
# gemini      gemini-2.5-pro · gemini-2.5-flash · gemini-2.0-flash · gemini-2.0-pro · gemini-1.5-pro · gemini-1.5-flash
# groq        llama-3.3-70b-versatile · llama-3.1-70b-versatile · mixtral-8x7b-32768 · gemma2-9b-it

# ─── SEEK search ──────────────────────────────────────────────────────
# Comma-separated keywords. One SEEK search per keyword.
SEARCH_KEYWORDS=graduate software engineer,junior software engineer,ai engineer,machine learning engineer
SEARCH_LOCATION=All Australia
# 1, 3, 7, 14, or 31 (SEEK supports these specific values)
DATE_RANGE_DAYS=7
# Polite cap per keyword
MAX_JOBS_PER_KEYWORD=40

# ─── Browser ──────────────────────────────────────────────────────────
HEADLESS=true
SLOW_MO_MS=120

# ─── SEEK login (auto-apply) ──────────────────────────────────────────
# Credentials for unattended re-login. The persisted session below is tried
# first; these are the fallback when it expires. SEEK may still require an
# emailed code or captcha — in that case run `career-ops seek-login --manual`
# once (a visible browser) to sign in by hand; the session is then cached.
SEEK_EMAIL=
SEEK_PASSWORD=
# Where the reusable login session (cookies + localStorage) is stored.
# Gitignored. Delete this file to force a fresh login.
SEEK_AUTH_STATE_PATH=data/seek-auth.json
# Your DEFAULT resume's filename substring — the one you upload by hand and want
# kept forever. Resume cleanup (seek_resume_delete_old) and rotation NEVER delete
# a resume whose filename contains this; rotation also re-pins it as the Profile
# default after each upload. e.g. set to "resume_default" if your default file is
# "Jincheng Deng_AI Engineer_resume_default.pdf". Leave empty to disable (note:
# seek_resume_delete_old then refuses to run, to avoid wiping every resume).
SEEK_PROTECTED_RESUME=resume_default
# MASTER SUBMIT SWITCH. Leave false (test mode): every seek-apply run fills the
# form and stops at the review page, NEVER clicking "Submit application". Set
# true AND pass --submit to actually submit. Keep false during development.
SEEK_ALLOW_SUBMIT=false
# Batch (seek-apply --batch) caps: max applications per run, min fit score.
SEEK_MAX_APPLIES_PER_RUN=5
SEEK_APPLY_MIN_SCORE=4.0

# ─── Storage paths ────────────────────────────────────────────────────
# All defaults are relative to the repo root.
PROFILE_DIR=profile
DB_PATH=data/seek.sqlite3
APPLICATIONS_DIR=output
REPORTS_DIR=reports

# ─── Scoring ──────────────────────────────────────────────────────────
# Threshold (out of 5) for the STRONG recommendation. BORDERLINE is between this and 3.0.
SCORE_THRESHOLD_STRONG=4.0

# ─── Email delivery (apply-job auto-send) ────────────────────────────
# When all four EMAIL_USER / EMAIL_APP_PASSWORD / EMAIL_TO are set,
# `apply-job` automatically emails the generated PDF bundle (resume,
# cover letter, company brief) to EMAIL_TO once generation finishes.
# Pass --no-email to skip per-call. Defaults assume Gmail; override the
# host/port for any other SMTP provider.
#
# Gmail setup:
#   1. Enable 2-Step Verification on the Google account
#   2. Create an App Password at https://myaccount.google.com/apppasswords
#      (it must be an App Password — a normal Gmail password will not work)
#   3. Paste the 16-char password (spaces optional) into EMAIL_APP_PASSWORD
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
# Leave EMAIL_SECURE blank to auto-pick (true for 465, false for 587).
EMAIL_SECURE=
EMAIL_USER=
EMAIL_APP_PASSWORD=
# EMAIL_FROM defaults to EMAIL_USER. Set explicitly if you send from an alias.
EMAIL_FROM=
# Where the application bundle is delivered. Usually your own inbox.
EMAIL_TO=
# Optional subject prefix.
EMAIL_SUBJECT_PREFIX=[career-ops]

# ─── Webhook delivery (send-files tool — standalone) ─────────────────
# Used only by `career-ops send-files`, not by apply-job. Set this if
# you want a default webhook for ad-hoc file pushes to a group chat.
# Provider currently supported: wecom (WeChat Work / 企业微信 group bot).
# Get a webhook URL by creating a group bot in your WeCom group → copy
# the URL with `?key=...` at the end.
WEBHOOK_PROVIDER=wecom
WEBHOOK_URL=

# ─── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_JSON=false

# ─── MCP server (career-ops-mcp / npm run mcp-serve) ──────────────────
# The stateful MCP daemon your local agent connects to. It holds one live
# browser session across tool calls (so it can keep a logged-in session open
# while it asks you for a captcha/code). Same config on a Mac (test) and a
# Raspberry Pi (prod).
# Host to bind. Keep on loopback unless you deliberately expose it.
MCP_HOST=127.0.0.1
# Port for the Streamable-HTTP daemon.
MCP_PORT=8731
# Close the browser after this many ms idle (saves RAM on a Pi). Cookies are
# persisted on close, so a logged-in session is restored on the next launch.
MCP_BROWSER_IDLE_MS=600000
