# ─── Personal data ────────────────────────────────────────────────────
# Everything under profile/ is personal (CV, scanned IDs, certificates).
# Ignore the WHOLE directory — listing individual files is what let
# "Internship Certificate.JPG" slip through before.
profile/
profile/profile.md
profile/profile.json
profile/.profile.hash

# Defense-in-depth: never commit scanned documents / ID images anywhere.
*.jpg
*.jpeg
*.JPG
*.JPEG
*.png
*.PNG
*.pdf
*.PDF
*.heic
*.HEIC
*.docx
*.doc

# ─── Generated ────────────────────────────────────────────────────────
data/*.sqlite3
data/*.sqlite3-shm
data/*.sqlite3-wal
data/applications.md
output/
reports/
.web-cache/

# ─── Build artefacts ──────────────────────────────────────────────────
dist/
*.tsbuildinfo

# ─── Secrets ──────────────────────────────────────────────────────────
.env
.env.local
# Persisted SEEK login session (cookies + localStorage) — never commit.
data/seek-auth.json
# Human-input broker request/response (may briefly hold a code/password).
data/agent-input/

# ─── Node ─────────────────────────────────────────────────────────────
node_modules/
package-lock.json
bun.lock
pnpm-lock.yaml
yarn.lock

# ─── OS / IDE ─────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/

# ─── Claude Code local ────────────────────────────────────────────────
.claude/settings.local.json
.claude/memory/
