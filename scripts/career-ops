#!/usr/bin/env bash
# career-ops — invocation shim for the openclaw skills.
#
# Resolves the repo root from this script's location, then delegates to
# the TypeScript bin via `npx tsx src/bin.ts`. This means:
#   - no `npm link` needed
#   - no global `career-ops` binary needed
#   - SKILL.md "How to invoke" lines bake in the absolute path
#     to this shim during install
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

cd "$REPO_ROOT"
exec npx --yes tsx src/bin.ts "$@"
