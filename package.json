{
  "name": "career-ops",
  "version": "0.1.0",
  "private": true,
  "description": "SEEK-focused job search pipeline — scan, evaluate, tailor resume + cover letter, render PDFs. Composable tools wired as openclaw skills.",
  "type": "module",
  "bin": {
    "career-ops": "dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/bin.ts",
    "start": "node dist/bin.js",
    "career-ops": "tsx src/bin.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "better-sqlite3": "^11.5.0",
    "dompurify": "^3.2.0",
    "dotenv": "^16.4.5",
    "jsdom": "^25.0.1",
    "marked": "^14.1.3",
    "nodemailer": "^8.0.7",
    "openai": "^6.37.0",
    "playwright": "^1.48.2",
    "sanitize-html": "^2.13.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^8.0.0",
    "@types/sanitize-html": "^2.13.0",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3"
  }
}
